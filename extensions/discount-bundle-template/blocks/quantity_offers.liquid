<script>
(()=>{const root=document.querySelector('.quantity-offers--{{ block.id }}'),catalogEl=root?.querySelector('[data-catalog]');if(!root||root.dataset.ready||!catalogEl)return;root.dataset.ready='1';const normalise=p=>({...p,options:p.options||[],variants:(p.variants||[]).map(v=>({...v,price:typeof v.price==='string'?Math.round(Number(v.price)*100):Number(v.price),compare_at_price:typeof v.compare_at_price==='string'?Math.round(Number(v.compare_at_price)*100):Number(v.compare_at_price||0)}))}),catalog=JSON.parse(catalogEl.textContent||'[]').map(normalise),tiers=[...root.querySelectorAll('[data-tier]')],slots=root.querySelector('[data-slots]'),builder=root.querySelector('.quantity-offers__builder'),picker=root.querySelector('[data-picker]'),search=root.querySelector('[data-product-search]'),results=root.querySelector('[data-product-results]'),add=root.querySelector('[data-add-button]'),toast=root.querySelector('[data-toast]'),base=root.querySelector('[data-base-price]'),compare=root.querySelector('[data-base-compare]'),money=new Intl.NumberFormat(undefined,{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}),current='{{ product.id }}';let active=tiers[1]||tiers[0],choices=[],slot=0,loaded=false,timer;const esc=x=>String(x||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])),product=id=>catalog.find(p=>String(p.id)===String(id)),variant=(p,id)=>(p?.variants||[]).find(v=>String(v.id)===String(id)&&v.available)||(p?.variants||[]).find(v=>v.available),fresh=()=>{const p=product(current)||catalog[0],v=variant(p);return{productId:p?.id,variantId:v?.id}},colour=value=>{const t=String(value||'').toLowerCase(),m={black:'#202124',white:'#fff',grey:'#8c9299',gray:'#8c9299',blue:'#4d6fff',navy:'#1d315c',green:'#4d8a58',red:'#d65252',pink:'#ee9db7',purple:'#8a64b8',yellow:'#e4bd47',orange:'#e6813c',brown:'#855b43',beige:'#d9bd9c',cream:'#f1dfc8'},k=Object.keys(m).find(k=>t.includes(k));return m[k]||'#8796a5'},groups=p=>(p?.options||[]).map((o,i)=>{const name=typeof o==='string'?o:o.name,values=(typeof o==='string'?[...new Set((p.variants||[]).map(v=>v.options?.[i]))]:o.values||[]).map(v=>typeof v==='string'?v:v.name);return{name,values,index:i}}).filter(g=>!(g.name==='Title'&&g.values.length===1)),draw=()=>{const count=Math.max(1,Number(active?.dataset.quantity)||1);choices=choices.slice(0,count);while(choices.length<count)choices.push(fresh());const first=variant(product(choices[0]?.productId),choices[0]?.variantId);base.textContent=first?money.format(first.price/100):'';compare.textContent=first?.compare_at_price>first?.price?money.format(first.compare_at_price/100):'';slots.innerHTML=choices.map((choice,i)=>{const p=product(choice.productId),v=variant(p,choice.variantId),image=p?.image?`<img src="${esc(p.image)}" alt="${esc(p.title)}">`:'<span class="quantity-offers__image-empty">Product</span>',swatches=groups(p).map(g=>{const color=/colou?r|shade|tone/i.test(g.name),buttons=g.values.map(value=>{const selectable=(p?.variants||[]).some(x=>x.available&&x.options.every((option,n)=>n===g.index?option===value:option===v?.options?.[n])),attrs=color?` style="--qo-swatch:${colour(value)}" title="${esc(value)}" aria-label="${esc(g.name)}: ${esc(value)}"`:'';return`<button type="button" data-swatch="${i}" data-option="${g.index}" data-value="${esc(value)}"${v?.options?.[g.index]===value?' class="is-selected"':''}${selectable?'':' disabled'}${attrs}>${color?'<em></em>':esc(value)}</button>`}).join('');return`<div class="quantity-offers__swatches${color?' is-colour':''}"><strong><small>Choose</small>${esc(g.name)}</strong><span>${buttons}</span></div>`}).join('');return`<article class="quantity-offers__slot">${image}<div class="quantity-offers__slot-fields"><label class="quantity-offers__product-choice"><small>Product ${i+1}</small>Choose product<button type="button" data-product="${i}">${esc(p?.title)}</button></label>${swatches}</div></article>`}).join('')},choose=t=>{active=t;tiers.forEach(x=>x.classList.toggle('is-selected',x===t));t.insertAdjacentElement('afterend',builder);draw()},show=()=>{const query=search.value.toLowerCase();results.innerHTML=catalog.filter(p=>p.title.toLowerCase().includes(query)).slice(0,30).map(p=>`<button type="button" data-product-pick="${p.id}">${esc(p.title)}</button>`).join('')||'No products found'},load=async()=>{if(loaded)return;loaded=true;try{for(let page=1;;page+=1){const response=await fetch('{{ offer_collection.url }}/products.json?limit=250&page='+page);if(!response.ok)throw 0;const items=(await response.json()).products||[];items.map(normalise).forEach(p=>{if(!product(p.id))catalog.push(p)});if(items.length<250)break}show()}catch(_){loaded=false}},notify=message=>{toast.textContent=message;toast.hidden=false;clearTimeout(timer);timer=setTimeout(()=>toast.hidden=true,2500)},addToCart=async()=>{const quantities=new Map;choices.forEach(choice=>{const v=variant(product(choice.productId),choice.variantId);if(v)quantities.set(String(v.id),(quantities.get(String(v.id))||0)+1)});const items=[...quantities].map(([id,quantity])=>({id:Number(id),quantity}));if(!items.length)return notify('Choose an available product first.');add.disabled=true;add.textContent='Adding…';try{const response=await fetch('{{ routes.root_url }}cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items})});if(!response.ok)throw 0;document.dispatchEvent(new CustomEvent('cart:updated'));add.textContent='Added to cart';notify('Products added to cart');setTimeout(()=>{add.disabled=false;add.textContent='Add to cart'},2500)}catch(_){add.disabled=false;add.textContent='Add to cart';notify('Could not add this offer. Please try again.')}};root.addEventListener('click',event=>{const t=event.target.closest('[data-tier]');if(t)return choose(t);const b=event.target.closest('[data-product]');if(b){slot=Number(b.dataset.product);picker.hidden=false;search.value='';show();search.focus();load();return}const picked=event.target.closest('[data-product-pick]');if(picked){const p=product(picked.dataset.productPick),v=variant(p);if(p&&v)choices[slot]={productId:p.id,variantId:v.id};picker.hidden=true;draw();return}if(event.target.closest('[data-picker-close]')){picker.hidden=true;return}const swatch=event.target.closest('[data-swatch]');if(swatch){const i=Number(swatch.dataset.swatch),p=product(choices[i]?.productId),v=variant(p,choices[i]?.variantId),values=[...(v?.options||[])];values[Number(swatch.dataset.option)]=swatch.dataset.value;const next=(p?.variants||[]).find(x=>x.available&&x.options.every((value,n)=>value===values[n]));if(next)choices[i].variantId=next.id;draw();return}if(event.target.closest('[data-add-button]'))addToCart()});search.addEventListener('input',show);document.addEventListener('keydown',event=>{if(event.key==='Escape')picker.hidden=true});choose(active)})();
</script>
