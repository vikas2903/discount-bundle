{%- liquid
  assign offer_collection = block.settings.collection
  assign is_eligible_product = false
  if offer_collection != blank
    for product_collection in product.collections
      if product_collection.handle == offer_collection.handle
        assign is_eligible_product = true
        break
      endif
    endfor
  endif
-%}
{%- if is_eligible_product or request.design_mode -%}
  <section class="quantity-offers quantity-offers--{{ block.id }}" style="--qo-accent:{{ block.settings.accent_color | default: '#00865a' }}">
    {%- if offer_collection == blank -%}
      <p class="quantity-offers__empty">Choose an offer collection. This block will appear only on product pages for products in that collection.</p>
    {%- elsif is_eligible_product -%}
      <header class="quantity-offers__header"><span></span><strong>{{ block.settings.heading }}</strong><span></span></header>
      <div class="quantity-offers__tiers" aria-label="Choose a quantity offer">
        <button type="button" class="quantity-offers__tier quantity-offers__tier--base" data-tier data-quantity="1"><i></i><span><strong>Buy 1</strong><small>Everyday price</small></span><b><strong data-base-price></strong><s data-base-compare></s></b></button>
        <button type="button" class="quantity-offers__tier" data-tier data-quantity="{{ block.settings.tier_2_quantity }}"><i></i><span><strong>Buy {{ block.settings.tier_2_quantity }}</strong><small>{{ block.settings.tier_2_label }}</small></span><b>Save {{ block.settings.tier_2_discount_value }}% off</b></button>
        <button type="button" class="quantity-offers__tier" data-tier data-quantity="{{ block.settings.tier_3_quantity }}"><i></i><span><strong>Buy {{ block.settings.tier_3_quantity }}</strong><small>{{ block.settings.tier_3_label }}</small></span><b>Save {{ block.settings.tier_3_discount_value }}% off</b></button>
      </div>
      <section class="quantity-offers__builder">
        <div class="quantity-offers__builder-title"><i></i><span><strong>Select products &amp; variants</strong><small>Choose any combination from {{ offer_collection.title }}</small></span></div>
        <div class="quantity-offers__slots" data-slots></div>
        <div class="quantity-offers__picker" data-picker hidden><div role="dialog" aria-modal="true" aria-label="Choose a product"><button type="button" data-picker-close aria-label="Close product picker">×</button><input type="search" data-product-search placeholder="Search products" aria-label="Search products"><div data-product-results></div></div></div>
      </section>
      <div class="quantity-offers__footer"><button type="button" class="quantity-offers__button" data-add-button>Add to cart</button></div>
      <p class="quantity-offers__toast" data-toast role="status" hidden></p>
      {%- paginate offer_collection.products by 20 -%}
        <script type="application/json" data-catalog>[{%- for item in offer_collection.products -%}{"id":{{ item.id | json }},"title":{{ item.title | json }},"image":{%- if item.featured_image -%}{{ item.featured_image | image_url: width: 160 | json }}{%- else -%}null{%- endif -%},"options":{{ item.options_with_values | json }},"variants":{{ item.variants | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
      {%- endpaginate -%}
    {%- else -%}
      <p class="quantity-offers__empty">This offer is shown only for products in the selected collection.</p>
    {%- endif -%}
  </section>
{%- endif -%}
<style>
