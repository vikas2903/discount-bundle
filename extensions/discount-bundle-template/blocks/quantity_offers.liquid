lor:#102a43;font:inherit;font-weight:700;text-align:left;cursor:pointer}.quantity-offers--{{ block.id }} .quantity-offers__swatches{display:grid;gap:4px;font-size:10px}.quantity-offers--{{ block.id }} .quantity-offers__swatches strong{display:grid;gap:1px;color:#102a43}.quantity-offers--{{ block.id }} .quantity-offers__swatches strong small{color:#5f88a6;font-size:9px;font-weight:600}.quantity-offers--{{ block.id }} .quantity-offers__swatches>span{display:flex;flex-wrap:wrap;gap:5px}.quantity-offers--{{ block.id }} .quantity-offers__swatches button{min-width:45px;padding:5px 8px;border:1px solid var(--qo-accent);border-radius:6px;background:#fff;color:#102a43;cursor:pointer}.quantity-offers--{{ block.id }} .quantity-offers__swatches button.is-selected{background:var(--qo-accent);color:#fff}.quantity-offers--{{ block.id }} .quantity-offers__swatches button:disabled{opacity:.35;cursor:not-allowed}.quantity-offers--{{ block.id }} .quantity-offers__swatches.is-colour button{display:grid;place-items:center;min-width:29px;width:29px;height:29px;padding:3px;border-radius:50%;background:#fff}.quantity-offers--{{ block.id }} .quantity-offers__swatches.is-colour button em{width:100%;height:100%;border-radius:50%;background:var(--qo-swatch)}.quantity-offers--{{ block.id }} .quantity-offers__swatches.is-colour button.is-selected{padding:2px;border:2px solid var(--qo-accent)}.quantity-offers--{{ block.id }} .quantity-offers__footer{display:flex;margin-top:12px}.quantity-offers--{{ block.id }} .quantity-offers__button{display:flex;flex:1;align-items:center;justify-content:center;min-height:39px;border:0;border-radius:9px;background:var(--qo-accent);color:#fff;font-size:13px;font-weight:800;cursor:pointer}.quantity-offers--{{ block.id }} .quantity-offers__button:disabled{opacity:.6;cursor:not-allowed}.quantity-offers--{{ block.id }} .quantity-offers__empty{margin:0;color:#5f88a6;font-size:13px}.quantity-offers--{{ block.id }} .quantity-offers__picker{position:fixed;inset:0;z-index:10;display:grid;place-items:center;padding:16px;background:#0006}.quantity-offers--{{ block.id }} .quantity-offers__picker[hidden]{display:none}.quantity-offers--{{ block.id }} .quantity-offers__picker>div{position:relative;width:min(500px,100%);max-height:80vh;overflow:auto;padding:16px;border-radius:11px;background:#fff}.quantity-offers--{{ block.id }} .quantity-offers__picker input{width:100%;min-height:40px;padding:8px 10px;border:1px solid #d5e1e9;border-radius:7px;font:inherit}.quantity-offers--{{ block.id }} [data-product-results]{display:grid;gap:6px;margin-top:10px}.quantity-offers--{{ block.id }} [data-product-pick]{padding:9px;border:1px solid #dce7ed;border-radius:7px;background:#fff;color:#102a43;text-align:left;cursor:pointer}.quantity-offers--{{ block.id }} [data-picker-close]{position:absolute;top:5px;right:8px;border:0;background:none;font-size:22px;cursor:pointer}.quantity-offers--{{ block.id }} .quantity-offers__toast{position:fixed;right:18px;bottom:18px;z-index:9;margin:0;padding:12px 16px;border-radius:9px;background:var(--qo-accent);color:#fff;font-weight:700}.quantity-offers--{{ block.id }} .quantity-offers__toast[hidden]{display:none}@media(max-width:480px){.quantity-offers--{{ block.id }}{padding:14px}.quantity-offers--{{ block.id }} .quantity-offers__slot{grid-template-columns:60px minmax(0,1fr)}.quantity-offers--{{ block.id }} .quantity-offers__slot img,.quantity-offers--{{ block.id }} .quantity-offers__image-empty{width:60px;height:75px}}
