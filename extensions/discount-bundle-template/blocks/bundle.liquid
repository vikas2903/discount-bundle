.vs-modal .vs-dot::after { width:7px; height:7px; }
.vs-gallery-arrow { position:absolute; top:50%; transform:translateY(-50%); width:28px; height:32px; display:grid; place-items:center; padding:0; border:0; border-radius:50%; background:#ffffffba; opacity:0; transition:opacity .15s; z-index:3; font-size:22px !important; }
.vs-gallery:hover .vs-gallery-arrow, .vs-gallery:focus-within .vs-gallery-arrow { opacity:1; }
.vs-gallery-prev { left:6px; }
.vs-gallery-next { right:6px; }
.vs-gallery.is-chart .vs-dot::after { background:#a7a7a7; }
