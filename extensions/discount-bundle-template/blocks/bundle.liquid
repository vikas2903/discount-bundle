
{%- liquid
  assign bundle_collection = block.settings.bundle_collection
  assign bundle_collection_source = bundle_collection
  if bundle_collection.handle != blank
    assign bundle_collection_source = collections[bundle_collection.handle]
  endif
  assign bundle_required_quantity = block.settings.required_quantity | default: 2
  assign bundle_free_quantity = 0
  if block.settings.discount_type == 'free'
    assign bundle_free_quantity = block.settings.free_quantity | default: 1
  endif
  assign bundle_total_quantity = bundle_required_quantity | plus: bundle_free_quantity
  assign gokwik_button_title = settings['buynow-titile'] | default: block.settings.gokwik_checkout_label | default: 'Place Order'
-%}

<section class="vs-bundle" id="vs-bundle-{{ block.id }}" data-section-id="{{ block.id }}" data-shopify-section-id="{{ section.id }}" style="--vs-image-bg: {{ block.settings.product_image_background | default: '#f3f3f3' | escape }};--vs-native-checkout-bg:{{ block.settings.native_checkout_background | default: '#1b1b1b' }};--vs-native-checkout-text:{{ block.settings.native_checkout_text_color | default: '#ffffff' }};">
  <script type="application/json" data-bundle-config>
    {
      "maxProducts": {{ bundle_total_quantity | json }},
      "offerProducts": {{ bundle_total_quantity | json }},
      "requiredProducts": {{ bundle_required_quantity | json }},
      "freeProducts": {{ bundle_free_quantity | json }},
      "discountType": {{ block.settings.discount_type | json }},
      "discountValue": {{ block.settings.discount_value | json }},
      "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "customCheckoutCode": {{ block.settings.custom_checkout_code | json }},
      "productLabel": "",
      "offerLabel": "Rare Offer",
      "chartInSlider": {{ block.settings.size_chart_in_slider | json }},
      "chart": {% if block.settings.size_chart_image != blank %}{{ block.settings.size_chart_image | image_url: width: 2000 | json }}{% else %}null{% endif %},
      "charts": {}
    }
  </script>
  <template data-offer-content></template>
  <template data-return-content>{{ block.settings.return_policy_content }}</template>
  <template data-shipping-content>{{ block.settings.shipping_policy_content }}</template>
  <template data-policy-image>{% if block.settings.policy_content_image != blank %}<img src="{{ block.settings.policy_content_image | image_url: width: 1200 }}" alt="{{ block.settings.policy_content_image_alt | escape }}" width="1200" height="{{ 1200 | divided_by: block.settings.policy_content_image.aspect_ratio | round }}" loading="lazy">{% endif %}</template>

  {%- if bundle_collection_source != blank -%}
    {%- paginate bundle_collection_source.products by 20 -%}
      <script type="application/json" data-bundle-products>
        {
          "next": {{ paginate.next.url | json }},
          "products": [
            {%- for product in bundle_collection_source.products -%}
              {
                "product": {{ product | json | replace: '<', '\u003c' }},
                "url": {{ product.url | json }},
                "rating": {{ product.metafields.reviews.rating.value.rating | json }},
                "ratingCount": {{ product.metafields.reviews.rating_count.value | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endpaginate -%}
  {%- else -%}
    <script type="application/json" data-bundle-products>{"next":null,"products":[]}</script>
  {%- endif -%}

  <div class="vs-products-grid" data-grid></div>
  <p class="vs-empty" data-empty hidden>No products found in this collection.</p>
  <button type="button" class="vs-load-more" data-load-more hidden>Load more products</button>
  <p class="vs-status" data-status role="status" aria-live="polite"></p>
  <noscript><p>Enable JavaScript to build your bundle.</p></noscript>

  <div class="vs-bottom-bar" data-bottom-bar hidden>
    <div class="vs-bottom-inner">
      <div class="vs-pack-details" id="vs-pack-details-{{ block.id }}" data-pack-details hidden>
        <div class="vs-selected-items" data-selected-items aria-label="Products in your pack"></div>
      </div>
      <div class="vs-pack-progress">
        <ol class="vs-pack-steps" data-pack-steps aria-label="Bundle progress"></ol>
        <div class="vs-pack-offer">
          <p data-offer-info></p>
          <div><strong data-bundle-deal></strong> <span class="vs-savings" data-savings hidden></span></div>
        </div>
      </div>
      <div class="vs-pack-summary">
        <button type="button" class="vs-pack-toggle" data-pack-toggle aria-expanded="false" aria-controls="vs-pack-details-{{ block.id }}">
          <span class="vs-pack-preview" data-pack-preview aria-hidden="true"></span>
          <span><strong data-item-count></strong><span class="vs-pack-view">View <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1"/></svg></span></span>
        </button>
        <div class="vs-total"><s data-original-total hidden></s><strong data-total></strong></div>
        <div class="vs-checkout-area">
          <div class="vs-checkout-buttons">
            {%- if block.settings.checkout_provider == 'shiprocket' -%}
              <div class="shiprocket-headless vs-fastrr-btn" data-type="mini-cart" data-checkout></div>
            {%- elsif block.settings.checkout_provider == 'gokwik' -%}
              <div class="gokwik-checkout" data-type="mini-cart">
                <button data-checkout type="button" class="button disabled" disabled id="gokwik-buy-now" {% if settings.hideFlow %}style="display:none !important;"{% endif %}>
                  <div style="display:none" class="addloadr" id="btn-loader"><div class="cir-loader">Loading..</div></div>
                  <span class="btn-text"><span>{{ gokwik_button_title }}</span></span>
                  <span class="pay-opt-icon"><img src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt=""><img src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt=""></span>
                </button>
              </div>
            {%- elsif block.settings.checkout_provider == 'custom' -%}
              <div class="vs-custom-checkout" data-checkout aria-disabled="true">
                {%- if block.settings.custom_checkout_button_html != blank -%}
                  {{ block.settings.custom_checkout_button_html }}
                {%- else -%}
                  <button type="button" class="vs-custom-checkout-trigger">{{ block.settings.custom_checkout_label | default: 'Checkout' }}</button>
                {%- endif -%}
              </div>
            {%- else -%}
              <button type="button" class="vs-native-checkout" data-checkout data-native-checkout disabled>{{ block.settings.shopify_checkout_label | default: 'Checkout' }}</button>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="vs-modal" data-modal role="dialog" aria-modal="true" aria-labelledby="vs-title-{{ block.id }}" hidden>
    <div class="vs-modal-overlay" data-close></div>
    <div class="vs-modal-panel" tabindex="-1">
      <button type="button" class="vs-modal-close" data-close aria-label="Close quick view">&times;</button>
      <div data-modal-content></div>
    </div>
  </div>
</section>

<style>
#PBarNextFrameWrapper{display:none;}
.vs-pills button{text-transform:capitalize !important;}
.vs-checkout-area button.vs-native-checkout {color: #FFF;}
.vs-bundle { --vs-ink:#1b1b1b; --vs-teal:#008b78; --vs-line:#e2e3e7; box-sizing:border-box; max-width:1208px; margin:0 auto; padding:30px 20px 160px; color:var(--vs-ink); font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:1.5; }
