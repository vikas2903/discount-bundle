      const featured = imageSource(product.featured_image) || imageSource(product.images?.[0]);
      const matching = featured ? this.variants(product).filter(variant => imageSource(variant.featured_image) === featured) : [];
      const available = matching.find(variant => variant.available);
      if (available) return available;
      // Sizes can share a color even when only one size has an assigned image.
      const colorIndex = this.optionDefinitions(product).findIndex(option => /colou?r/i.test(option.name));
      const sameColor = colorIndex >= 0 && matching.length ? this.variants(product).find(variant => variant.available && variant.options[colorIndex] === matching[0].options[colorIndex]) : null;
      return sameColor || matching[0] || this.firstVariant(product);
    }
    updateEmptyState() {
      this.section.querySelector('[data-empty]').hidden = this.products.size > 0;
    }
    pinProductCard(entry) {
      const card = [...this.grid.querySelectorAll('.vs-card')].find(item => item.dataset.productId === String(entry.product.id));
      if (card) this.grid.prepend(card);
    }
    async pinProductFromURL() {
      const handle = this.attopHandle.toLowerCase();
      const existing = [...this.products.values()].find(entry => String(entry.product.handle || '').toLowerCase() === handle);
      if (existing) return this.pinProductCard(existing);
      try {
        const response = await fetch(`${this.root}products/${encodeURIComponent(this.attopHandle)}.js`, {signal:this.events.signal});
        if (!response.ok) return;
        const product = await response.json();
        if (!product?.id) return;
        const entry = {product, url:`${this.root}products/${encodeURIComponent(product.handle || this.attopHandle)}`, rating:null, ratingCount:null};
        this.products.set(String(product.id), entry);
        this.renderCard(entry);
        this.pinProductCard(entry);
        this.updateEmptyState();
      } catch (error) {
        // A missing or unavailable handle should not prevent the collection from loading.
        if (error.name !== 'AbortError') return;
      }
    }
    swatchBackground(value) {
      const color = String(value || '').trim().toLowerCase().replace(/[ _-]+/g, ' ');
      if (/^#[0-9a-f]{3,8}$/i.test(color)) return color;
      // Add or change hex values here for the exact Color option names used in Shopify.
      // Hyphens, spaces, and capital letters in the option name are ignored.
      const manualSwatchColors = {
        'black':'#111111',
        'bottle green':'#0b4f32',
        'navy blue':'#172554',
        'white':'#ffffff',
        'maroon':'#800020'
      };
      const colors = {
        black:'#161616', white:'#ffffff', ivory:'#fffff0', cream:'#fff4d6', beige:'#e8d5b5', nude:'#d7ab8a',
        grey:'#8c8c8c', gray:'#8c8c8c', silver:'#c0c0c0', charcoal:'#36454f', red:'#d62f2f', maroon:'#7d1f2a',
        pink:'#ef91ad', peach:'#f7b08b', orange:'#ed7d31', yellow:'#f4d34f', mustard:'#c99700', gold:'#d4af37',
        green:'#398a51', olive:'#7a8037', mint:'#a9d9bf', teal:'#14868c', turquoise:'#3fc2c5', blue:'#2d69bf',
        navy:'#1d2f5b', 'navy blue':'#1d2f5b', sky:'#78b9e6', purple:'#754aa5', lavender:'#b49bd8',
        brown:'#78513d', tan:'#c49a6c', khaki:'#bdb76b', 'off white':'#f7f4ec', multicolor:'linear-gradient(135deg,#e53935 0 25%,#f4d34f 25% 50%,#398a51 50% 75%,#2d69bf 75%)'
      };
      return manualSwatchColors[color] || colors[color] || Object.entries(colors).find(([name]) => color.includes(name))?.[1] || '#d9d9d9';
    }
    policyContent(selector, fallback = '') {
      const content = this.section.querySelector(selector)?.innerHTML.trim();
      const image = this.section.querySelector('[data-policy-image]')?.innerHTML.trim() || '';
      return `${content || fallback}${image ? `<figure class="vs-policy-image">${image}</figure>` : ''}`;
    }
    optionDefinitions(product) {
      return (product.options || []).map((option, index) => ({
        name:typeof option === 'string' ? option : option.name,
        values:option.values || [...new Set(this.variants(product).map(variant => variant.options[index]))]
      })).filter(option => option.name);
    }
    gallery(product, popup = false, entry = {}) {
      const slides = (product.images || []).map(imageSource).filter(Boolean).map(src => ({src, chart:false}));
      const chart = this.chart(product);
      if (chart && this.config.chartInSlider) slides.push({src:chart, chart:true});
      const sold = !this.variants(product).some(variant => variant.available);
      // The first slide is visible as soon as a product card is rendered.
      // Do not defer it: lazy loading can leave visible cards blank in theme previews.
      const images = slides.length ? slides.map((slide, index) => {
        const source = escapeHTML(slide.src);
        const alt = escapeHTML(slide.chart ? 'Size chart for ' + product.title : product.title + ' — image ' + (index + 1));
        const attributes = index === 0
          ? `src="${source}" loading="eager" fetchpriority="${popup ? 'auto' : 'high'}"`
          : `data-src="${source}" loading="lazy"`;
        return `<div class="vs-slide ${slide.chart ? 'vs-chart-slide' : ''}"><img ${attributes} alt="${alt}" decoding="async" width="600" height="900"></div>`;
