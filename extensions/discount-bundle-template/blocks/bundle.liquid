      }
      if (button.hasAttribute('data-card-add')) {
        const cardOptionIndexes = this.cardOptionIndexes(entry.product);
        const productOptionCount = this.optionDefinitions(entry.product).filter(option => !(option.name === 'Title' && option.values[0] === 'Default Title')).length;
