      const dots = slides.length > 1 ? `<div class="vs-gallery-dots">${slides.map((slide,index) => `<button type="button" class="vs-dot" data-slide="${index}" aria-label="${slide.chart ? 'Show size chart' : 'Show image ' + (index + 1)}" aria-current="${index === 0}"></button>`).join('')}</div><button type="button" class="vs-gallery-arrow vs-gallery-prev" data-direction="-1" aria-label="Previous image">‹</button><button type="button" class="vs-gallery-arrow vs-gallery-next" data-direction="1" aria-label="Next image">›</button>` : '';
      const rating = !popup && Number(entry.rating) > 0 ? `<span class="vs-rating"><span class="vs-rating-star">★</span> ${escapeHTML(entry.rating)}${Number(entry.ratingCount) > 0 ? ' (' + escapeHTML(entry.ratingCount) + ')' : ''}</span>` : '';
      return `<div class="vs-gallery" data-gallery><div class="vs-slides" tabindex="0" aria-label="${escapeHTML(product.title)} images">${images}</div>${rating}${!popup && sold ? '<div class="vs-sold-overlay"><span>Sold Out</span></div>' : ''}${dots}</div>`;
    }
    setupGalleries(container) {
      container.querySelectorAll('[data-gallery]').forEach(gallery => {
        const track = gallery.querySelector('.vs-slides');
        let frame;
        this.on(track, 'scroll', () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const index = Math.round(track.scrollLeft / (track.clientWidth || 1));
