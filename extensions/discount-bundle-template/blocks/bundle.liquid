      if (button.hasAttribute('data-direction')) return this.moveGallery(button.closest('[data-gallery]'), null, Number(button.dataset.direction));
      if (button.hasAttribute('data-open')) return this.openModal(entry, card, 'details');
      if (button.hasAttribute('data-open-tab')) return this.openModal(entry, card, button.dataset.openTab);
      if (button.hasAttribute('data-card-option')) {
        const optionIndex = Number(button.dataset.cardOption);
        const selections = this.cardSelections(card);
        selections[optionIndex] = button.dataset.value;
        card.dataset.cardSelections = JSON.stringify(selections);
        const previewVariant = this.cardPreviewVariant(entry.product, selections);
        const variant = this.cardOptionsReady(entry.product, selections) ? previewVariant : null;
        card.dataset.variantId = variant?.id || '';
        this.updateCard(card, previewVariant, true);
