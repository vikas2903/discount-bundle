      const button = event.target.closest('button');
      if (!button || button.disabled) return;
      const card = button.closest('.vs-card');
      const entry = card ? this.products.get(card.dataset.productId) : null;
      if (button.hasAttribute('data-close')) return this.closeModal();
      if (button.hasAttribute('data-pack-toggle')) { this.packExpanded = !this.packExpanded; this.updatePackDisclosure(); return; }
      if (button.hasAttribute('data-load-more')) return this.loadMore();
