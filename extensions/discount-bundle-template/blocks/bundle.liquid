    }
    loadGallerySlide(track, index) {
      const image = track.children[index]?.querySelector('img[data-src]');
      if (!image) return;
      image.src = image.dataset.src;
      image.removeAttribute('data-src');
    }
    moveGallery(gallery, index, direction) {
      const track = gallery.querySelector('.vs-slides');
      const length = track.children.length;
      const current = Math.round(track.scrollLeft / (track.clientWidth || 1));
      const next = index ?? (current + direction + length) % length;
      this.loadGallerySlide(track, next);
