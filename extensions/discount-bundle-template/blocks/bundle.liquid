{% schema %}
{
  "name": "Bundle Template",
  "target": "section",
  "settings": [
    {
      "type": "collection",
      "id": "bundle_collection",
      "label": "Products collection",
      "info": "Products from this collection are available to build the bundle."
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount type",
      "default": "fixed_price",
      "options": [
        { "value": "fixed_price", "label": "Buy a quantity at a fixed price" },
        { "value": "free", "label": "Buy X, get Y free" },
        { "value": "percentage", "label": "Buy a quantity and get a percentage off" }
      ]
    },
    {
      "type": "range",
      "id": "required_quantity",
      "label": "Required quantity",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "free_quantity",
      "label": "Free quantity (Buy X, get Y free only)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "number",
      "id": "discount_value",
      "label": "Fixed bundle price or percentage off",
      "default": 999,
      "info": "Enter the total price for a fixed-price offer, or the percentage for a percentage-off offer."
    },
    {
      "type": "header",
      "content": "Customization"
    },
    {
      "type": "checkbox",
      "id": "allow_additional_products",
      "label": "Allow products after the bundle is complete",
      "default": false,
      "info": "When enabled, shoppers can add more products after completing the bundle, including another variant of a product already in the bundle."
    },
    {
      "type": "header",
      "content": "Checkout"
    },
    {
      "type": "select",
      "id": "checkout_provider",
      "label": "Checkout button",
      "default": "shopify",
      "options": [
        { "value": "shopify", "label": "Shopify checkout" },
        { "value": "shiprocket", "label": "Shiprocket checkout" },
        { "value": "gokwik", "label": "GoKwik checkout" },
        { "value": "custom", "label": "Custom checkout" }
      ],
      "info": "Only the selected checkout button is shown. Shiprocket and GoKwik must already be installed in the theme."
    },
    {
      "type": "text",
      "id": "shopify_checkout_label",
      "label": "Shopify checkout button label",
      "default": "Checkout"
    },
    {
      "type": "color",
      "id": "native_checkout_background",
      "label": "Shopify checkout button background",
      "default": "#1b1b1b"
    },
    {
      "type": "color",
      "id": "native_checkout_text_color",
      "label": "Shopify checkout button text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "gokwik_checkout_label",
      "label": "GoKwik button label",
      "default": "Place Order"
    },
    {
      "type": "text",
