      this.restoreSelection();
    }

    on(target, type, listener, options = {}) {
      target.addEventListener(type, listener, {...options, signal:this.events.signal});
    }
    money(value) {
      try {
        return new Intl.NumberFormat(undefined, {style:'currency', currency:this.config.currency}).format(Number(value) || 0);
      } catch (_) {
        return Number(value || 0).toFixed(2);
      }
      return '₹' + Number(value).toLocaleString('en-IN', {maximumFractionDigits:2});
    }
    offerText() {
      if (this.discountType === 'free') return `Buy ${this.requiredProducts}, get ${this.freeProducts} free`;
      if (this.discountType === 'percentage') return `Buy ${this.requiredProducts} and get ${this.discountValue}% off`;
      return `Buy ${this.requiredProducts} for ${this.money(this.discountValue)}`;
    }
    offerTotal(regular) {
      if (this.discountType === 'percentage') return regular * Math.max(0, 1 - Math.min(100, this.discountValue) / 100);
      if (this.discountType === 'free') {
        const freeTotal = [...this.selected]
          .sort((left, right) => left.price - right.price)
          .slice(0, this.freeProducts)
          .reduce((sum, item) => sum + item.price, 0);
        return Math.max(0, regular - freeTotal);
      }
      return Math.min(regular, this.discountValue);
    }
    label(product) { return this.config.productLabel || product.type || ''; }
    chart(product) { return this.config.charts?.[String(product.id)] || this.config.chart || ''; }
    variants(product) { return product.variants || []; }
    firstVariant(product) { return this.variants(product).find(variant => variant.available) || this.variants(product)[0]; }
