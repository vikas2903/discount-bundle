      }
      if (button.hasAttribute('data-modal-option')) return this.selectModalOption(Number(button.dataset.modalOption), button.dataset.value);
      if (button.hasAttribute('data-tab')) return this.selectTab(button.dataset.tab);
      if (button.hasAttribute('data-modal-add')) return this.toggleProduct(this.currentEntry, this.currentVariant, true);
      if (button.hasAttribute('data-remove')) return this.removeProduct(button.dataset.remove);
    }
    openModal(entry, card, tab) {
      if (!entry) return;
      this.currentEntry = entry;
      this.currentVariant = this.variants(entry.product).find(item => String(item.id) === card?.dataset.variantId) || this.firstVariant(entry.product);
      this.modalOptions = [...(this.currentVariant?.options || [])];
      this.returnFocus = document.activeElement;
      this.previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      this.modal.hidden = false;
      const product = entry.product;
      const hasChart = !!this.chart(product);
      const tabButton = (name, text) => `<button type="button" class="vs-tab" id="vs-tab-${name}-${this.id}" data-tab="${name}" role="tab" aria-controls="vs-panel-${name}-${this.id}" aria-selected="false" tabindex="-1">${text}</button>`;
      const panel = (name, body) => `<div class="vs-tab-panel" id="vs-panel-${name}-${this.id}" data-tab-panel="${name}" role="tabpanel" aria-labelledby="vs-tab-${name}-${this.id}" tabindex="0" hidden>${body}</div>`;
      this.modalContent.innerHTML = `${this.gallery(product, true)}
        <div class="vs-modal-info"><p class="vs-modal-label">${escapeHTML(this.label(product))}</p>
          <h2 class="vs-modal-title" id="vs-title-${this.id}">${escapeHTML(product.title)}</h2>
          <div class="vs-modal-price" data-modal-price></div><p class="vs-offer-copy">${escapeHTML(this.offerText())}</p>
          <div data-modal-options></div>
        </div>
        <div class="vs-tabs" role="tablist" aria-label="Product information">${tabButton('details','DETAILS')}${hasChart ? tabButton('size','SIZE CHART') : ''}${tabButton('shipping','SHIPPING')}</div>
        ${panel('details', product.description || '<p>No additional product details available.</p>')}
        ${hasChart ? panel('size', `<img src="${escapeHTML(this.chart(product))}" alt="Size chart for ${escapeHTML(product.title)}" width="1200" height="1200" loading="lazy">`) : ''}
        ${panel('shipping', this.policyContent('[data-shipping-content]', '<p>Shipping options are shown at checkout.</p>'))}
        <div class="vs-tab-panel" data-policy-panel hidden></div>
        <div class="vs-modal-footer"><p class="vs-modal-error" data-modal-error role="status" hidden></p><button type="button" class="vs-add" data-modal-add></button>
          <a class="vs-full-details" href="${escapeHTML(entry.url || this.root + 'products/' + product.handle)}">View Full Details</a>
        </div>`;
      this.setupGalleries(this.modalContent);
      this.renderModalOptions();
      this.updateModalVariant();
      this.selectTab(tab);
      this.panel.scrollTop = 0;
      this.panel.focus({preventScroll:true});
      if (tab !== 'details') requestAnimationFrame(() => this.scrollToInfo());
    }
    renderModalOptions() {
      const product = this.currentEntry.product;
      const options = this.optionDefinitions(product);
      const colorIndex = options.findIndex(option => /colou?r/i.test(option.name));
      const html = options.map((option, index) => {
        if (option.name === 'Title' && option.values[0] === 'Default Title') return '';
        const isColor = index === colorIndex;
        return `<div class="vs-option-group"><span class="vs-option-label">${escapeHTML(option.name)}:</span><div class="vs-options">${option.values.map(value => {
          // Availability respects prior groups; changing color can select an available size.
          const available = this.variants(product).some(variant => variant.available && variant.options[index] === value && variant.options.every((item,i) => i >= index || item === this.modalOptions[i]));
          if (isColor) return `<button type="button" class="vs-color-swatch" style="--vs-swatch:${this.swatchBackground(value)}" data-modal-option="${index}" data-value="${escapeHTML(value)}" aria-label="Select ${escapeHTML(option.name)}: ${escapeHTML(value)}" title="${escapeHTML(value)}" aria-pressed="${this.modalOptions[index] === value}" ${available ? '' : 'disabled'}><span class="vs-visually-hidden">${escapeHTML(value)}</span></button>`;
          return `<button type="button" class="vs-size" data-modal-option="${index}" data-value="${escapeHTML(value)}" aria-pressed="${this.modalOptions[index] === value}" ${available ? '' : 'disabled'}>${escapeHTML(value)}</button>`;
        }).join('')}</div></div>`;
      }).join('');
      this.modalContent.querySelector('[data-modal-options]').innerHTML = html;
    }
    selectModalOption(index, value) {
      const variants = this.variants(this.currentEntry.product);
      this.modalOptions[index] = value;
      const match = variants.find(variant => variant.available && variant.options.every((option,i) => option === this.modalOptions[i])) ||
        variants.find(variant => variant.available && variant.options.every((option,i) => i > index || option === this.modalOptions[i]));
      this.currentVariant = match || null;
      if (match) this.modalOptions = [...match.options];
      this.renderModalOptions();
      this.updateModalVariant();
      if (match?.featured_image) {
        const src = imageSource(match.featured_image);
        const images = (this.currentEntry.product.images || []).map(imageSource);
        const index = images.indexOf(src);
        if (index >= 0) this.moveGallery(this.modalContent.querySelector('[data-gallery]'), index);
      }
    }
    priceMarkup(variant) {
      if (!variant) return 'Unavailable';
      const discounted = variant.compare_at_price > variant.price;
      return `<strong>${this.money(variant.price / 100)}</strong>${discounted ? `<s>${this.money(variant.compare_at_price / 100)}</s><span class="vs-discount">-${Math.round((1 - variant.price / variant.compare_at_price) * 100)}%</span>` : ''}`;
    }
    updateModalVariant() {
      if (!this.currentEntry) return;
      const variant = this.currentVariant;
      const price = this.modalContent.querySelector('[data-modal-price]');
      price.innerHTML = this.priceMarkup(variant);
      this.setAddButton(this.modalContent.querySelector('[data-modal-add]'), variant);
      const link = this.modalContent.querySelector('.vs-full-details');
      const url = new URL(this.currentEntry.url || this.root + 'products/' + this.currentEntry.product.handle, window.location.origin);
      if (variant) url.searchParams.set('variant', variant.id);
      link.href = url.href;
    }
    selectTab(name) {
      const policy = this.modalContent.querySelector('[data-policy-panel]');
      policy.hidden = !['offer','returns'].includes(name);
      if (!policy.hidden) {
        const body = name === 'offer' ? this.section.querySelector('[data-offer-content]').innerHTML : this.policyContent('[data-return-content]');
        policy.innerHTML = `<h3 class="vs-policy-title">${escapeHTML(name === 'offer' ? this.config.offerLabel || 'Rare Offer' : 'Return Policy')}</h3>${name === 'offer' ? `<p>${escapeHTML(this.offerText())}</p>` : ''}${body}`;
      }
      this.modalContent.querySelectorAll('[data-tab]').forEach(button => {
        const active = button.dataset.tab === name;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active || (!policy.hidden && button.dataset.tab === 'details') ? 0 : -1;
      });
      this.modalContent.querySelectorAll('[data-tab-panel]').forEach(panel => { panel.hidden = panel.dataset.tabPanel !== name; });
    }
    scrollToInfo() {
      if (this.modal.hidden) return;
      const info = this.modalContent.querySelector('.vs-tabs');
      this.panel.scrollTop = Math.max(0, info.offsetTop - 12);
    }
    closeModal() {
      if (this.modal.hidden) return;
      this.modal.hidden = true;
      document.body.style.overflow = this.previousOverflow || '';
      this.currentEntry = null;
      this.currentVariant = null;
      if (this.returnFocus?.isConnected) this.returnFocus.focus({preventScroll:true});
    }
    handleKeydown(event) {
      if (this.modal.hidden) return;
      if (event.key === 'Escape') { event.preventDefault(); this.closeModal(); return; }
      if (event.target.matches('[data-tab]') && ['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) {
        event.preventDefault();
        const tabs = [...this.modalContent.querySelectorAll('[data-tab]')];
        let index = tabs.indexOf(event.target);
        index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        this.selectTab(tabs[index].dataset.tab);
        tabs[index].focus();
      }
      if (event.key === 'Tab') {
        const focusable = [...this.panel.querySelectorAll('button:not(:disabled), a[href], [tabindex="0"]')].filter(node => node.getClientRects().length);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && (document.activeElement === first || document.activeElement === this.panel)) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && (document.activeElement === last || document.activeElement === this.panel)) { event.preventDefault(); first?.focus(); }
      }
    }
    setAddButton(button, variant, optionsSelected = true) {
      const selected = this.selected.some(item => item.variantId === String(variant?.id));
      const sold = !variant?.available;
      const full = this.selected.length >= this.maxProducts && !selected;
      // A selected variant remains actionable so the same card button can remove
      // it from the temporary bundle.
      button.disabled = this.busy || !optionsSelected || sold || full;
      button.classList.toggle('is-added', selected);
      const text = !optionsSelected ? 'SELECT OPTIONS' : sold ? 'SOLD OUT' : selected ? 'REMOVE FROM PACK' : full ? 'PACK FULL' : 'ADD TO PACK';
      button.innerHTML = `${selected ? '<span aria-hidden="true">✓</span>' : ''}${optionsSelected && !sold && !selected && !full ? '<span class="vs-add-plus" aria-hidden="true">+</span>' : ''}<span>${text}</span>`;
    }
    updateCard(card, previewVariant = null, syncGallery = false) {
      const product = this.products.get(card.dataset.productId)?.product;
      if (!product) return;
      const variant = this.variants(product).find(item => String(item.id) === card.dataset.variantId);
      const selections = this.cardSelections(card);
      const optionsSelected = this.cardOptionsReady(product, selections);
      const displayVariant = variant || previewVariant || this.firstVariant(product);
      card.querySelectorAll('[data-card-option]').forEach(button => button.setAttribute('aria-pressed', String(selections[Number(button.dataset.cardOption)] === button.dataset.value)));
      card.querySelector('[data-card-price]').innerHTML = this.priceMarkup(displayVariant);
      this.setAddButton(card.querySelector('[data-card-add]'), variant, optionsSelected && !!variant);
      // Keep Shopify's image order on load. Only move for a shopper's selection
      // or a restored selection, rather than resetting galleries on every UI update.
      const galleryVariant = variant || previewVariant;
      if (syncGallery && galleryVariant?.featured_image) {
        const image = imageSource(galleryVariant.featured_image);
        const imageIndex = (product.images || []).map(imageSource).indexOf(image);
        if (imageIndex >= 0) this.moveGallery(card.querySelector('[data-gallery]'), imageIndex);
      }
      const added = this.selected.some(item => item.productId === String(product.id));
      card.classList.toggle('is-added', added);
      let badge = card.querySelector('.vs-added-badge');
      if (added && !badge) {
        badge = document.createElement('span');
        badge.className = 'vs-added-badge';
        badge.textContent = '✓ Added';
        card.querySelector('[data-gallery]').append(badge);
      } else if (!added) badge?.remove();
    }
    async requestCart(path, body) {
      const response = await fetch(this.root + path, body ? {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)} : {});
      const data = await response.json();
      if (!response.ok || data.status >= 400) throw new Error(data.description || data.message || 'Unable to update your pack. Please try again.');
      return data;
    }
    toggleProduct(entry, variant, fromModal = false) {
      if (this.busy || !entry || !variant?.available) return;
      const existing = this.selected.find(item => item.variantId === String(variant.id));
      if (existing) {
        this.removeProduct(String(variant.id));
        if (fromModal) this.closeModal();
        return;
      }
      if (this.selected.length >= this.maxProducts) return;
      // Keep selections in session storage until checkout. This prevents cart drawers
      // (including GoKwik) from opening once for every product a customer picks.
      const selectedItem = {
        productId:String(entry.product.id),
        variantId:String(variant.id),
        price:variant.price / 100,
        comparePrice:Math.max(variant.price, variant.compare_at_price || 0) / 100,
        label:this.label(entry.product),
        variantTitle:(variant.options || []).filter(value => value !== 'Default Title').join(' / '),
        title:entry.product.title,
        image:imageSource(variant.featured_image) || imageSource(entry.product.images?.[0])
      };
      this.selected.push(selectedItem);
      // Keep the card on the option selected in quick view so its state stays in sync.
      const card = [...this.grid.querySelectorAll('.vs-card')].find(card => card.dataset.productId === String(entry.product.id));
      if (card) {
        card.dataset.variantId = String(variant.id);
        card.dataset.cardSelections = JSON.stringify(Object.fromEntries((variant.options || []).map((value, index) => [index, value])));
        this.updateCard(card, null, true);
      }
      this.saveSelection();
      this.showMessage(`${entry.product.title} added to your pack.`);
      this.updateUI();
      if (fromModal) this.closeModal();
    }
    removeProduct(variantId) {
      if (this.busy) return;
      const item = this.selected.find(product => product.variantId === variantId);
      if (!item) return;
      this.selected = this.selected.filter(product => product.variantId !== variantId);
      this.saveSelection();
      this.showMessage(`${item.title} removed from your pack.`);
      this.updateUI();
    }
    showMessage(message, error = false) {
      this.section.querySelector('[data-status]').textContent = message;
      const modalError = this.modalContent.querySelector('[data-modal-error]');
      if (modalError) { modalError.hidden = !error; modalError.textContent = error ? message : ''; }
    }
    saveSelection() {
      try { sessionStorage.setItem(this.storageKey, JSON.stringify(this.selected)); } catch (_) { /* Storage may be blocked. */ }
    }
    async restoreSelection() {
      try {
        const saved = JSON.parse(sessionStorage.getItem(this.storageKey) || '[]');
        if (Array.isArray(saved) && saved.length) {
          this.selected = saved.filter(item => item.variantId && Number.isFinite(item.price)).slice(0, this.maxProducts);
          this.grid.querySelectorAll('.vs-card').forEach(card => {
            const item = this.selected.find(item => item.productId === card.dataset.productId);
            if (item) {
              card.dataset.variantId = item.variantId;
              const product = this.products.get(card.dataset.productId)?.product;
              const variant = this.variants(product || {}).find(variant => String(variant.id) === item.variantId);
              if (variant) card.dataset.cardSelections = JSON.stringify(Object.fromEntries((variant.options || []).map((value, index) => [index, value])));
              this.updateCard(card, null, true);
            }
          });
          this.updateUI();
        }
      } catch (_) { /* A new pack remains usable when storage is unavailable. */ }
    }
    async checkoutBundle(checkout) {
      if (!this.canCheckout()) return;
      this.busy = true;
      this.updateUI();
      this.showMessage('Adding your pack to cart…');
      try {
        await this.requestCart('cart/add.js', {items:this.selected.map(item => ({id:item.variantId, quantity:1}))});
        try { sessionStorage.removeItem(this.storageKey); } catch (_) { /* Checkout can continue when storage is unavailable. */ }
        document.dispatchEvent(new CustomEvent('cart:updated'));
        if (checkout.hasAttribute('data-native-checkout')) return window.location.assign(this.root + 'checkout');
        if (checkout.closest('.gokwik-checkout')) {
          if (typeof window.onCheckoutClick === 'function') return window.onCheckoutClick(checkout.querySelector('button') || checkout);
          // Do not silently fall back to Shopify checkout. A GoKwik-labelled
          // button must only open GoKwik; a fallback here makes an incomplete
          // GoKwik theme installation look like it is working.
          throw new Error('GoKwik checkout is not ready. Enable the GoKwik app embed in this published theme and reload the page.');
        }
        if (checkout.closest('.vs-custom-checkout')) return this.runCustomCheckout(checkout);
        // Shiprocket attaches its own click handler to the rendered control. Let it
        // run after the bundle has been added, without re-entering this listener.
        return this.handoffToProvider(checkout);
      } catch (error) {
        this.busy = false;
        this.showMessage(error.message, true);
        if (!this.destroyed) this.updateUI();
      }
    }
    runCustomCheckout(checkout) {
      const code = String(this.config.customCheckoutCode || '').trim();
      // A custom button may be provider-supplied HTML (for example, Shoprocket's
      // headless placeholder) without any additional JavaScript here. In that
      // case, invoke the provider's rendered control. Never fall back to Shopify
      // checkout: that masks a missing/incorrect provider integration.
      if (!code) return this.handoffToProvider(checkout, true);
      const payload = {
        checkoutElement:checkout,
        checkoutButton:checkout.querySelector('button, a, [role="button"]'),
        cartUrl:this.root + 'cart',
        checkoutUrl:this.root + 'checkout',
        selectedItems:this.selected.map(item => ({id:item.variantId, quantity:1}))
      };
      try {
        // This is merchant-authored storefront integration code. It receives only
        // public checkout context after the bundle has been added to cart.
        new Function('payload', 'window', 'document', code)(payload, window, document);
      } catch (error) {
        this.busy = false;
        this.showMessage('Custom checkout could not be started. Please check its app-block code.', true);
        if (!this.destroyed) this.updateUI();
      }
    }
    handoffToProvider(checkout, isCustom = false) {
      const providerButton = checkout.matches('button, a, [role="button"]')
        ? checkout
        : checkout.querySelector('button, a, [role="button"]');
      // The generic custom trigger is deliberately not a Shopify checkout
      // button. It only tells the merchant that a provider control is missing.
      if (!providerButton || (isCustom && providerButton.classList.contains('vs-custom-checkout-trigger'))) {
        throw new Error(isCustom
          ? 'Custom checkout is not ready. Add the Shoprocket button HTML or custom checkout code, then reload the page.'
          : 'Shiprocket checkout is not ready. Enable its app embed in this published theme and reload the page.');
      }
      // updateUI disables controls while cart items are being added. Re-enable the
      // provider control briefly so its own click handler can receive this handoff.
      const wasDisabled = 'disabled' in providerButton ? providerButton.disabled : false;
      const previousAriaDisabled = providerButton.getAttribute('aria-disabled');
      if ('disabled' in providerButton) providerButton.disabled = false;
      providerButton.setAttribute('aria-disabled', 'false');
      this.handoffCheckout = true;
      try {
        providerButton.click();
      } finally {
        this.handoffCheckout = false;
        if ('disabled' in providerButton) providerButton.disabled = wasDisabled;
        if (previousAriaDisabled === null) providerButton.removeAttribute('aria-disabled');
        else providerButton.setAttribute('aria-disabled', previousAriaDisabled);
      }
    }
    canCheckout() { return !this.busy && this.selected.length === this.offerProducts; }
    updateCheckout() {
      const enabled = this.canCheckout();
      this.checkouts.forEach(checkout => {
        checkout.setAttribute('aria-disabled', String(!enabled));
        const buttons = checkout.matches('button, a, [role="button"]')
          ? [checkout]
          : [...checkout.querySelectorAll('button, a, [role="button"]')];
        buttons.forEach(button => {
          if ('disabled' in button) button.disabled = !enabled;
          if (button.id === 'gokwik-buy-now') button.classList.toggle('disabled', !enabled);
          button.setAttribute('aria-disabled', String(!enabled));
        });
      });
    }
    updatePackDisclosure() {
      if (!this.selected.length) this.packExpanded = false;
      this.section.querySelector('[data-pack-details]').hidden = !this.packExpanded;
      this.section.querySelector('[data-pack-toggle]').setAttribute('aria-expanded', String(this.packExpanded));
    }
    updateUI() {
      this.grid.querySelectorAll('.vs-card').forEach(card => this.updateCard(card));
      if (this.currentEntry) this.updateModalVariant();
      const count = this.selected.length;
      this.section.querySelector('[data-bottom-bar]').hidden = !count;
      this.section.querySelector('[data-selected-items]').innerHTML = this.selected.map(item => `<div class="vs-selected-item">
        <div class="vs-selected-photo">${item.image ? `<img src="${escapeHTML(item.image)}" alt="${escapeHTML(item.title)}" width="45" height="46">` : ''}<span class="vs-item-quantity">1</span></div>
        <div class="vs-selected-copy"><span class="vs-selected-label">${escapeHTML(item.label || '')}</span><strong class="vs-selected-title">${escapeHTML(item.title)}</strong><span class="vs-selected-variant">${escapeHTML(item.variantTitle || '')}</span><span class="vs-selected-price">${this.money(item.price)}</span></div>
        <button type="button" data-remove="${escapeHTML(item.variantId)}" aria-label="Remove ${escapeHTML(item.title)} from pack" ${this.busy ? 'disabled' : ''}>×</button>
      </div>`).join('');
      this.section.querySelector('[data-pack-preview]').innerHTML = this.selected.slice(0,3).filter(item => item.image).map(item => `<img src="${escapeHTML(item.image)}" alt="" width="30" height="32">`).join('');
      this.section.querySelector('[data-item-count]').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
      const regular = this.selected.reduce((sum, item) => sum + item.price, 0);
      const compare = this.selected.reduce((sum, item) => sum + Math.max(item.price, item.comparePrice || 0), 0);
      const offer = count === this.offerProducts;
      const total = offer ? this.offerTotal(regular) : regular;
      this.section.querySelector('[data-total]').textContent = this.money(total);
      const originalElement = this.section.querySelector('[data-original-total]');
      originalElement.hidden = compare <= total;
      originalElement.textContent = this.money(compare);
      const savings = this.section.querySelector('[data-savings]');
      savings.hidden = compare <= total;
      savings.textContent = `SAVE ${this.money(Math.max(0, compare - total))}`;
      this.section.querySelector('[data-bundle-deal]').textContent = this.offerText();
      const remaining = Math.max(0, this.offerProducts - count);
      this.section.querySelector('[data-offer-info]').innerHTML = remaining ? `Just <strong>${remaining} more</strong> for best deal!` : '<strong>Your pack is complete!</strong>';
      const check = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      this.section.querySelector('[data-pack-steps]').innerHTML = Array.from({length:this.offerProducts}, (_,index) => `<li class="vs-pack-step ${index < count ? 'is-complete' : index === count ? 'is-next' : ''}" aria-label="Product ${index + 1}: ${index < count ? 'added' : 'remaining'}"><span class="vs-step-circle">${index < count ? check : index + 1}</span></li>`).join('');
      this.updatePackDisclosure();
      this.updateCheckout();
    }
    destroy() {
      this.closeModal();
      this.destroyed = true;
      this.events.abort();
      this.observer?.disconnect();
      this.checkoutObserver?.disconnect();
      delete this.section.vsBundle;
    }
    static mount(root) {
      root.querySelectorAll('.vs-bundle').forEach(section => {
        if (!section.vsBundle) section.vsBundle = new VSBundleSection(section);
      });
    }
  }
  window.VSBundleSection = VSBundleSection;
  VSBundleSection.mount(document);
  document.addEventListener('DOMContentLoaded', () => VSBundleSection.mount(document), {once:true});
  document.addEventListener('shopify:section:load', event => VSBundleSection.mount(event.target));
  document.addEventListener('shopify:section:unload', event => event.target.querySelectorAll('.vs-bundle').forEach(section => section.vsBundle?.destroy()));
})();

</script>


