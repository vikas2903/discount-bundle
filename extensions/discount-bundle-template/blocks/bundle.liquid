  const imageSource = image => typeof image === 'string' ? image : image?.src || '';
  const eyeIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
  const rulerIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m3 16 13-13 5 5L8 21Z M13 6l3 3 M10 9l2 2 M7 12l3 3 M4 15l2 2"/></svg>';

  class VSBundleSection {
