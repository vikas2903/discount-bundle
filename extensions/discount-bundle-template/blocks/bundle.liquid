      this.maxProducts = Math.max(1, Number(this.config.maxProducts) || 2);
      this.offerProducts = Math.min(this.maxProducts, Math.max(1, Number(this.config.offerProducts) || 2));
      this.requiredProducts = Math.min(this.offerProducts, Math.max(1, Number(this.config.requiredProducts) || this.offerProducts));
      this.freeProducts = Math.max(0, Number(this.config.freeProducts) || 0);
      this.discountType = ['fixed_price', 'percentage', 'free'].includes(this.config.discountType) ? this.config.discountType : 'fixed_price';
      this.discountValue = Math.max(0, Number(this.config.discountValue) || 0);
      this.root = window.Shopify?.routes?.root || '/';
      this.products = new Map();
      this.selected = [];
      this.busy = false;
      this.packExpanded = false;
