      "min": 1,
      "max": 50,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "free_quantity",
      "label": "Free quantity (Buy X, get Y free only)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
