    }
    cardOptionIndexes(product) {
      const options = this.optionDefinitions(product);
      const colorIndex = options.findIndex(option => /colou?r/i.test(option.name));
      const sizeIndex = options.findIndex(option => /size/i.test(option.name));
      const indexes = [...new Set([colorIndex, sizeIndex].filter(index => index >= 0))];
      if (!indexes.length && options[0] && !(options[0].name === 'Title' && options[0].values[0] === 'Default Title')) indexes.push(0);
      return indexes;
    }
    cardSelections(card) {
      try { return JSON.parse(card.dataset.cardSelections || '{}'); } catch (_) { return {}; }
    }
    cardOptionsReady(product, selections) {
      return this.cardOptionIndexes(product).every(index => selections[index] !== undefined && selections[index] !== '');
    }
    cardPreviewVariant(product, selections) {
      const selectedIndexes = this.cardOptionIndexes(product).filter(index => selections[index] !== undefined && selections[index] !== '');
      return this.variants(product).find(item => item.available && selectedIndexes.every(index => item.options[index] === selections[index])) || this.firstVariant(product);
    }
    cardOptions(product, variant) {
      const options = this.optionDefinitions(product);
      const colorIndex = options.findIndex(option => /colou?r/i.test(option.name));
      // Product cards stay compact, while still offering the two choices customers need most.
      const indexes = this.cardOptionIndexes(product);
      return indexes.map(index => {
        const option = options[index];
        if (!option || (option.name === 'Title' && option.values[0] === 'Default Title')) return '';
        const isColor = index === colorIndex;
        const buttons = option.values.map(value => {
          const available = this.variants(product).some(item => item.available && item.options[index] === value);
          if (isColor) return `<button type="button" class="vs-color-swatch" style="--vs-swatch:${this.swatchBackground(value)}" data-card-option="${index}" data-value="${escapeHTML(value)}" aria-label="Select ${escapeHTML(option.name)}: ${escapeHTML(value)}" title="${escapeHTML(value)}" aria-pressed="${variant?.options[index] === value}" ${available ? '' : 'disabled'}><span class="vs-visually-hidden">${escapeHTML(value)}</span></button>`;
          return `<button type="button" class="vs-size" data-card-option="${index}" data-value="${escapeHTML(value)}" aria-pressed="${variant?.options[index] === value}" ${available ? '' : 'disabled'}>${escapeHTML(value)}</button>`;
        }).join('');
        return `<div class="vs-card-option-group"><span class="vs-card-option-label">${escapeHTML(option.name)}:</span><div class="vs-options">${buttons}</div></div>`;
      }).join('');
    }
    renderCard(entry) {
      const product = entry.product;
      const selectedVariant = this.variants(product).find(variant => this.selected.some(item => item.variantId === String(variant.id)));
      const variant = selectedVariant || this.initialVariant(product);
      const displayVariant = variant;
      const card = document.createElement('article');
      const available = this.variants(product).some(item => item.available);
      card.className = 'vs-card' + (available ? '' : ' is-sold-out');
      card.dataset.productId = product.id;
      card.dataset.variantId = variant?.id || '';
      card.dataset.cardSelections = JSON.stringify(Object.fromEntries((variant?.options || []).map((value, index) => [index, value])));
      const label = this.label(product);
      const returns = this.section.querySelector('[data-return-content]').innerHTML.trim();
      card.innerHTML = `${this.gallery(product, false, entry)}<div class="vs-card-info">
        ${label ? `<p class="vs-product-label">${escapeHTML(label)}</p>` : ''}
        <h3 class="vs-product-title">${escapeHTML(product.title)}</h3>
        <button type="button" class="vs-quick-view" data-open aria-label="Quick view ${escapeHTML(product.title)}">${eyeIcon}</button>
        <p class="vs-card-price" data-card-price></p>
        <p class="vs-offer-copy">${escapeHTML(this.offerText())}</p>
        ${this.chart(product) ? `<div class="vs-size-heading"><span>OPTIONS:</span><button type="button" class="vs-size-link" data-open-tab="size">${rulerIcon} SIZE</button></div>` : ''}
        <div class="vs-card-options">${this.cardOptions(product, variant)}</div>
        <div class="vs-pills"><button type="button" class="vs-pill" data-open-tab="shipping">ⓘ Shipping Policy</button>${returns ? '<button type="button" class="vs-pill" data-open-tab="returns">ⓘ Easy Returns</button>' : ''}</div>
        <button type="button" class="vs-add" data-card-add></button>
      </div>`;
      this.grid.append(card);
      this.setupGalleries(card);
      this.updateCard(card, null, !!selectedVariant);
    }
    appendProducts(data) {
      for (const entry of data.products || []) {
