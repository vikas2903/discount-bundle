        this.products.set(key, entry);
        this.renderCard(entry);
      }
      this.nextURL = data.next;
      this.loadButton.hidden = !this.nextURL;
      this.updateEmptyState();
    }
    async loadMore() {
      if (!this.nextURL || this.loading || this.destroyed) return;
      this.loading = true;
      this.loadFailed = false;
      this.loadButton.disabled = true;
      this.loadButton.textContent = 'Loading products…';
      try {
        const url = new URL(this.nextURL, window.location.href);
        // Shopify's Section Rendering API requires the enclosing section ID,
        // not this app block's ID. Keeping loading manual avoids repeated
        // requests when the button remains visible after a response.
        if (this.shopifySectionId) url.searchParams.set('section_id', this.shopifySectionId);
        const response = await fetch(url, {signal:this.events.signal});
        if (!response.ok) throw new Error('Unable to load products.');
        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const data = doc.querySelector('[data-bundle-products]');
        if (!data) throw new Error('Products were not returned.');
        this.appendProducts(JSON.parse(data.textContent));
        this.loadButton.textContent = 'Load more products';
      } catch (error) {
        if (error.name !== 'AbortError') {
          this.loadFailed = true;
          this.loadButton.textContent = 'Could not load products — retry';
        }
      } finally {
        this.loading = false;
        this.loadButton.disabled = false;
      }
