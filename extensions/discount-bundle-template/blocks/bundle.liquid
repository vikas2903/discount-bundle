.vs-card .vs-add { margin-top:auto; }
.vs-add:disabled { background:#8e8e8e; }
.vs-add-plus { font-size:18px; line-height:1; font-weight:400; }
.vs-load-more { display:block; margin:25px auto !important; padding:10px 20px; background:#fff; border:1px solid var(--vs-line); border-radius:5px; }
